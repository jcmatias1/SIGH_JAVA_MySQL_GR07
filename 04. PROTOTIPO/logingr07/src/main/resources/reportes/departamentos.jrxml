</band></pageFooter>
<summary><band height="280">
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="4" width="555" height="22" forecolor="#4B5563"><printWhenExpression><![CDATA[$V{REPORT_COUNT} == 0]]></printWhenExpression></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["No hay departamentos registrados."]]></textFieldExpression></textField>
<barChart><chart isShowLegend="false" evaluationTime="Report"><reportElement x="0" y="58" width="555" height="215"><property name="net.sf.jasperreports.chart.range.axis.tick.interval" value="1"/><printWhenExpression><![CDATA[$V{REPORT_COUNT} > 0]]></printWhenExpression></reportElement>
<chartTitle color="#082A52"><font size="10" isBold="true"/><titleExpression><![CDATA["Empleados activos por departamento"]]></titleExpression></chartTitle><chartSubtitle/><chartLegend/></chart>
<categoryDataset><categorySeries><seriesExpression><![CDATA["Empleados activos"]]></seriesExpression><categoryExpression><![CDATA[$F{PEDEP_CODIGO}]]></categoryExpression><valueExpression><![CDATA[$F{EMPLEADOS}]]></valueExpression></categorySeries></categoryDataset>
<barPlot isShowLabels="true"><plot backcolor="#FFFFFF"><seriesColor seriesOrder="0" color="#0B5CAD"/></plot><itemLabel/><categoryAxisFormat><axisFormat/></categoryAxisFormat><valueAxisFormat><axisFormat tickLabelMask="#,##0"/></valueAxisFormat></barPlot></barChart>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="32" width="555" height="18" forecolor="#082A52"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Total de departamentos: " + $V{REPORT_COUNT} + "   ·   Total de cargos: " + $V{TOTAL_CARGOS} + "   ·   Empleados activos: " + $V{TOTAL_EMPLEADOS}]]></textFieldExpression></textField>
</band></summary>


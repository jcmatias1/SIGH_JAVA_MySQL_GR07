<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGH GR07 · Taller 3: reporte departamentos (abrir y editar en Jaspersoft Studio 6.21.5) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="departamentos" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bd_monster"/>
<property name="com.jaspersoft.studio.unit." value="pixel"/>
<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>

<parameter name="USUARIO" class="java.lang.String"><defaultValueExpression><![CDATA["admin"]]></defaultValueExpression></parameter>
<parameter name="FILTROS" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="BUSCAR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<queryString language="SQL"><![CDATA[SELECT d.PEDEP_CODIGO, d.PEDEP_DESCRI,
       (SELECT COUNT(*) FROM PECAR_CARGO c WHERE c.PEDEP_CODIGO = d.PEDEP_CODIGO) AS CARGOS,
       (SELECT COUNT(*) FROM PEEMP_EMPLE e WHERE e.PEDEP_CODIGO = d.PEDEP_CODIGO AND e.PEEMP_ESTADO = 'A') AS EMPLEADOS
FROM PEDEP_DEPAR d
WHERE $P{BUSCAR} = '' OR CONCAT_WS(' ', d.PEDEP_CODIGO, d.PEDEP_DESCRI) LIKE CONCAT('%', $P{BUSCAR}, '%')
ORDER BY d.PEDEP_CODIGO]]></queryString>
<field name="PEDEP_CODIGO" class="java.lang.String"/>
<field name="PEDEP_DESCRI" class="java.lang.String"/>
<field name="CARGOS" class="java.lang.Long"/>
<field name="EMPLEADOS" class="java.lang.Long"/>
<variable name="TOTAL_CARGOS" class="java.lang.Long" calculation="Sum"><variableExpression><![CDATA[$F{CARGOS}]]></variableExpression></variable>
<variable name="TOTAL_EMPLEADOS" class="java.lang.Long" calculation="Sum"><variableExpression><![CDATA[$F{EMPLEADOS}]]></variableExpression></variable>
<title><band height="70">
<rectangle><reportElement x="0" y="0" width="555" height="62" forecolor="#082A52" backcolor="#082A52"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
<staticText><reportElement x="8" y="4" width="330" height="16" forecolor="#9CC3EE"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[HOSPITAL GENERAL MONSTER SALUD]]></text></staticText>
<staticText><reportElement x="8" y="18" width="330" height="26" forecolor="#FFFFFF"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="17" isBold="true"/></textElement><text><![CDATA[Reporte de departamentos]]></text></staticText>
<staticText><reportElement x="8" y="42" width="330" height="16" forecolor="#C7DBF2"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><text><![CDATA[SIGH · Subsistema de Personal · GR07]]></text></staticText>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="287" y="6" width="260" height="16" forecolor="#FFFFFF"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="287" y="22" width="260" height="16" forecolor="#FFFFFF"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Generado por: " + $P{USUARIO}]]></textFieldExpression></textField>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="340" y="38" width="207" height="16" forecolor="#FFFFFF"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{FILTROS}.isEmpty() ? "Todos los departamentos" : "Filtros: " + $P{FILTROS}]]></textFieldExpression></textField>
</band></title>
<columnHeader><band height="22"><staticText><reportElement x="0" y="0" width="80" height="22" forecolor="#082A52" mode="Opaque" backcolor="#E3EFFB"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
<staticText><reportElement x="80" y="0" width="315" height="22" forecolor="#082A52" mode="Opaque" backcolor="#E3EFFB"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Departamento]]></text></staticText>
<staticText><reportElement x="395" y="0" width="80" height="22" forecolor="#082A52" mode="Opaque" backcolor="#E3EFFB"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[N.º de cargos]]></text></staticText>
<staticText><reportElement x="475" y="0" width="80" height="22" forecolor="#082A52" mode="Opaque" backcolor="#E3EFFB"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Empleados activos]]></text></staticText></band></columnHeader>
<detail><band height="20"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="80" height="20" forecolor="#1F2937"></reportElement><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#D5E1EE"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{PEDEP_CODIGO}]]></textFieldExpression></textField>

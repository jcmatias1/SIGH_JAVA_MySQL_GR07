<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="395" y="0" width="80" height="20" forecolor="#1F2937"></reportElement><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#D5E1EE"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{CARGOS}]]></textFieldExpression></textField>
<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="475" y="0" width="80" height="20" forecolor="#1F2937"></reportElement><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#D5E1EE"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{EMPLEADOS}]]></textFieldExpression></textField></band></detail>
<pageFooter><band height="22">

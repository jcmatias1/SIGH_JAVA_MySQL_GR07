<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGH GR07 · Taller 3: reporte empleado_ficha (abrir y editar en Jaspersoft Studio 6.21.5) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="empleado_ficha" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="NoDataSection">
<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bd_monster"/>
<property name="com.jaspersoft.studio.unit." value="pixel"/>
<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
<subDataset name="Academicos">
<parameter name="EMPLEADO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT n.PENIV_DESCRI, a.PEACA_INSTIT, a.PEACA_TITULO
FROM PEACA_ACADE a JOIN PENIV_NIVEL n ON n.PENIV_CODIGO = a.PENIV_CODIGO
WHERE a.PEEMP_CODIGO = $P{EMPLEADO}
ORDER BY a.PEACA_CODIGO]]></queryString>
<field name="PENIV_DESCRI" class="java.lang.String"/>
<field name="PEACA_INSTIT" class="java.lang.String"/>
<field name="PEACA_TITULO" class="java.lang.String"/>
</subDataset>
<subDataset name="Familiares">
<parameter name="EMPLEADO" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT p.PEPAR_DESCRI, f.PEFAM_APELLI, f.PEFAM_NOMBRE, f.PEFAM_FECNAC
FROM PEFAM_FAMIL f JOIN PEPAR_PAREN p ON p.PEPAR_CODIGO = f.PEPAR_CODIGO
WHERE f.PEEMP_CODIGO = $P{EMPLEADO}
ORDER BY f.PEFAM_CODIGO]]></queryString>
<field name="PEPAR_DESCRI" class="java.lang.String"/>
<field name="PEFAM_APELLI" class="java.lang.String"/>
<field name="PEFAM_NOMBRE" class="java.lang.String"/>
<field name="PEFAM_FECNAC" class="java.util.Date"/>
</subDataset>
<parameter name="USUARIO" class="java.lang.String"><defaultValueExpression><![CDATA["admin"]]></defaultValueExpression></parameter>
<parameter name="FILTROS" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="EMPLEADO" class="java.lang.String"><defaultValueExpression><![CDATA["EMP0000004"]]></defaultValueExpression></parameter>
<queryString language="SQL"><![CDATA[SELECT e.PEEMP_CODIGO, e.PEEMP_CEDULA, e.PEEMP_APELLI, e.PEEMP_NOMBRE, e.PEEMP_ESTADO,
       e.PEEMP_FECNAC, g.PEGEN_DESCRI, ec.PEESC_DESCRI, ts.PETSA_DESCRI, e.PEEMP_PESO, e.PEEMP_ESTATU,
       d.PEDEP_DESCRI, c.PECAR_DESCRI, e.PEEMP_REGPRO, e.PEEMP_DIRECC, e.PEEMP_TELEFO, e.PEEMP_EMAIL,
       (SELECT COUNT(*) FROM PEACA_ACADE a WHERE a.PEEMP_CODIGO = e.PEEMP_CODIGO) AS TITULOS,
       (SELECT COUNT(*) FROM PEFAM_FAMIL f WHERE f.PEEMP_CODIGO = e.PEEMP_CODIGO) AS FAMILIARES
FROM PEEMP_EMPLE e
JOIN PEGEN_GENER g ON g.PEGEN_CODIGO = e.PEGEN_CODIGO
LEFT JOIN PEESC_ESTCI ec ON ec.PEESC_CODIGO = e.PEESC_CODIGO
LEFT JOIN PETSA_TIPSA ts ON ts.PETSA_CODIGO = e.PETSA_CODIGO
JOIN PEDEP_DEPAR d ON d.PEDEP_CODIGO = e.PEDEP_CODIGO
JOIN PECAR_CARGO c ON c.PEDEP_CODIGO = e.PEDEP_CODIGO AND c.PECAR_CODIGO = e.PECAR_CODIGO
WHERE e.PEEMP_CODIGO = $P{EMPLEADO}]]></queryString>
<field name="PEEMP_CODIGO" class="java.lang.String"/>
<field name="PEEMP_CEDULA" class="java.lang.String"/>
<field name="PEEMP_APELLI" class="java.lang.String"/>
<field name="PEEMP_NOMBRE" class="java.lang.String"/>
<field name="PEEMP_ESTADO" class="java.lang.String"/>
<field name="PEEMP_FECNAC" class="java.util.Date"/>
<field name="PEGEN_DESCRI" class="java.lang.String"/>
<field name="PEESC_DESCRI" class="java.lang.String"/>
<field name="PETSA_DESCRI" class="java.lang.String"/>
<field name="PEEMP_PESO" class="java.math.BigDecimal"/>
<field name="PEEMP_ESTATU" class="java.math.BigDecimal"/>
<field name="PEDEP_DESCRI" class="java.lang.String"/>
<field name="PECAR_DESCRI" class="java.lang.String"/>
<field name="PEEMP_REGPRO" class="java.lang.String"/>
<field name="PEEMP_DIRECC" class="java.lang.String"/>
<field name="PEEMP_TELEFO" class="java.lang.String"/>
<field name="PEEMP_EMAIL" class="java.lang.String"/>
<field name="TITULOS" class="java.lang.Long"/>
<field name="FAMILIARES" class="java.lang.Long"/>


<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGH GR07 · Taller 3: reporte empleados (abrir y editar en Jaspersoft Studio 6.21.5) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="empleados" language="java" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bd_monster"/>
<property name="com.jaspersoft.studio.unit." value="pixel"/>
<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>
<subDataset name="PorDepartamento">
<parameter name="DEPARTAMENTO" class="java.lang.String"/>
<parameter name="CARGO" class="java.lang.String"/>
<parameter name="ESTADO" class="java.lang.String"/>
<parameter name="GENERO" class="java.lang.String"/>
<parameter name="ESTADO_CIVIL" class="java.lang.String"/>
<parameter name="TIPO_SANGRE" class="java.lang.String"/>
<parameter name="FECHA_DESDE" class="java.lang.String"/>
<parameter name="FECHA_HASTA" class="java.lang.String"/>
<parameter name="BUSCAR" class="java.lang.String"/>
<queryString language="SQL"><![CDATA[SELECT d.PEDEP_DESCRI AS DEPARTAMENTO, COUNT(*) AS TOTAL
FROM PEEMP_EMPLE e JOIN PEDEP_DEPAR d ON d.PEDEP_CODIGO = e.PEDEP_CODIGO
JOIN PECAR_CARGO c ON c.PEDEP_CODIGO = e.PEDEP_CODIGO AND c.PECAR_CODIGO = e.PECAR_CODIGO
WHERE ($P{DEPARTAMENTO} = '' OR e.PEDEP_CODIGO = $P{DEPARTAMENTO})
  AND ($P{CARGO} = '' OR CONCAT(e.PEDEP_CODIGO, '|', e.PECAR_CODIGO) = $P{CARGO})
  AND ($P{ESTADO} = '' OR e.PEEMP_ESTADO = $P{ESTADO})
  AND ($P{GENERO} = '' OR e.PEGEN_CODIGO = $P{GENERO})
  AND ($P{ESTADO_CIVIL} = '' OR e.PEESC_CODIGO = $P{ESTADO_CIVIL})
  AND ($P{TIPO_SANGRE} = '' OR e.PETSA_CODIGO = $P{TIPO_SANGRE})
  AND ($P{FECHA_DESDE} = '' OR e.PEEMP_FECNAC >= $P{FECHA_DESDE})
  AND ($P{FECHA_HASTA} = '' OR e.PEEMP_FECNAC <= $P{FECHA_HASTA})
  AND ($P{BUSCAR} = '' OR CONCAT_WS(' ', e.PEEMP_CODIGO, e.PEEMP_CEDULA, e.PEEMP_APELLI, e.PEEMP_NOMBRE, d.PEDEP_DESCRI,
       c.PECAR_DESCRI, e.PEEMP_TELEFO, e.PEEMP_EMAIL, IF(e.PEEMP_ESTADO = 'A', 'Activo', 'Inactivo')) LIKE CONCAT('%', $P{BUSCAR}, '%'))
GROUP BY d.PEDEP_DESCRI
ORDER BY d.PEDEP_DESCRI]]></queryString>
<field name="DEPARTAMENTO" class="java.lang.String"/>
<field name="TOTAL" class="java.lang.Long"/>
</subDataset>
<parameter name="USUARIO" class="java.lang.String"><defaultValueExpression><![CDATA["admin"]]></defaultValueExpression></parameter>
<parameter name="FILTROS" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="DEPARTAMENTO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="CARGO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="ESTADO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="GENERO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="ESTADO_CIVIL" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="TIPO_SANGRE" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="FECHA_DESDE" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="FECHA_HASTA" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="BUSCAR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<queryString language="SQL"><![CDATA[SELECT e.PEEMP_CODIGO, e.PEEMP_CEDULA, e.PEEMP_APELLI, e.PEEMP_NOMBRE, d.PEDEP_DESCRI, c.PECAR_DESCRI,
       e.PEEMP_TELEFO, e.PEEMP_EMAIL, e.PEEMP_ESTADO
FROM PEEMP_EMPLE e
JOIN PEDEP_DEPAR d ON d.PEDEP_CODIGO = e.PEDEP_CODIGO
JOIN PECAR_CARGO c ON c.PEDEP_CODIGO = e.PEDEP_CODIGO AND c.PECAR_CODIGO = e.PECAR_CODIGO
WHERE ($P{DEPARTAMENTO} = '' OR e.PEDEP_CODIGO = $P{DEPARTAMENTO})
  AND ($P{CARGO} = '' OR CONCAT(e.PEDEP_CODIGO, '|', e.PECAR_CODIGO) = $P{CARGO})
  AND ($P{ESTADO} = '' OR e.PEEMP_ESTADO = $P{ESTADO})
  AND ($P{GENERO} = '' OR e.PEGEN_CODIGO = $P{GENERO})
  AND ($P{ESTADO_CIVIL} = '' OR e.PEESC_CODIGO = $P{ESTADO_CIVIL})
  AND ($P{TIPO_SANGRE} = '' OR e.PETSA_CODIGO = $P{TIPO_SANGRE})
  AND ($P{FECHA_DESDE} = '' OR e.PEEMP_FECNAC >= $P{FECHA_DESDE})
  AND ($P{FECHA_HASTA} = '' OR e.PEEMP_FECNAC <= $P{FECHA_HASTA})
  AND ($P{BUSCAR} = '' OR CONCAT_WS(' ', e.PEEMP_CODIGO, e.PEEMP_CEDULA, e.PEEMP_APELLI, e.PEEMP_NOMBRE, d.PEDEP_DESCRI,
       c.PECAR_DESCRI, e.PEEMP_TELEFO, e.PEEMP_EMAIL, IF(e.PEEMP_ESTADO = 'A', 'Activo', 'Inactivo')) LIKE CONCAT('%', $P{BUSCAR}, '%'))
ORDER BY e.PEEMP_APELLI, e.PEEMP_NOMBRE]]></queryString>
<field name="PEEMP_CODIGO" class="java.lang.String"/>
<field name="PEEMP_CEDULA" class="java.lang.String"/>
<field name="PEEMP_APELLI" class="java.lang.String"/>
<field name="PEEMP_NOMBRE" class="java.lang.String"/>
<field name="PEDEP_DESCRI" class="java.lang.String"/>
<field name="PECAR_DESCRI" class="java.lang.String"/>
<field name="PEEMP_TELEFO" class="java.lang.String"/>
<field name="PEEMP_EMAIL" class="java.lang.String"/>
<field name="PEEMP_ESTADO" class="java.lang.String"/>


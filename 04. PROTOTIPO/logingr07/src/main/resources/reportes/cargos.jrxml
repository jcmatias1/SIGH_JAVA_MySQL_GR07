<?xml version="1.0" encoding="UTF-8"?>
<!-- SIGH GR07 · Taller 3: reporte cargos (abrir y editar en Jaspersoft Studio 6.21.5) -->
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="cargos" language="java" pageWidth="595" pageHeight="842" orientation="Portrait" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" whenNoDataType="AllSectionsNoDetail">
<property name="com.jaspersoft.studio.data.defaultdataadapter" value="bd_monster"/>
<property name="com.jaspersoft.studio.unit." value="pixel"/>
<style name="Base" isDefault="true" fontName="DejaVu Sans" fontSize="9"/>

<parameter name="USUARIO" class="java.lang.String"><defaultValueExpression><![CDATA["admin"]]></defaultValueExpression></parameter>
<parameter name="FILTROS" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="DEPARTAMENTO" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<parameter name="BUSCAR" class="java.lang.String"><defaultValueExpression><![CDATA[""]]></defaultValueExpression></parameter>
<queryString language="SQL"><![CDATA[SELECT c.PEDEP_CODIGO, d.PEDEP_DESCRI, c.PECAR_CODIGO, c.PECAR_DESCRI,
       (SELECT COUNT(*) FROM PEEMP_EMPLE e
         WHERE e.PEDEP_CODIGO = c.PEDEP_CODIGO AND e.PECAR_CODIGO = c.PECAR_CODIGO AND e.PEEMP_ESTADO = 'A') AS EMPLEADOS
FROM PECAR_CARGO c
JOIN PEDEP_DEPAR d ON d.PEDEP_CODIGO = c.PEDEP_CODIGO
WHERE ($P{DEPARTAMENTO} = '' OR c.PEDEP_CODIGO = $P{DEPARTAMENTO})
  AND ($P{BUSCAR} = '' OR CONCAT_WS(' ', c.PEDEP_CODIGO, d.PEDEP_DESCRI, c.PECAR_CODIGO, c.PECAR_DESCRI) LIKE CONCAT('%', $P{BUSCAR}, '%'))
ORDER BY c.PEDEP_CODIGO, c.PECAR_DESCRI]]></queryString>
<field name="PEDEP_CODIGO" class="java.lang.String"/>
<field name="PEDEP_DESCRI" class="java.lang.String"/>
<field name="PECAR_CODIGO" class="java.lang.String"/>
<field name="PECAR_DESCRI" class="java.lang.String"/>
<field name="EMPLEADOS" class="java.lang.Long"/>
<variable name="CARGOS_DEP" class="java.lang.Integer" resetType="Group" resetGroup="Departamento" calculation="Count"><variableExpression><![CDATA[$F{PECAR_CODIGO}]]></variableExpression></variable>
<group name="Departamento">
<groupExpression><![CDATA[$F{PEDEP_CODIGO}]]></groupExpression>
<groupHeader><band height="48"><printWhenExpression><![CDATA[$F{PEDEP_CODIGO} != null]]></printWhenExpression>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="4" width="555" height="22" forecolor="#FFFFFF" mode="Opaque" backcolor="#0B5CAD"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{PEDEP_CODIGO} + " · " + $F{PEDEP_DESCRI}]]></textFieldExpression></textField>
<staticText><reportElement x="0" y="26" width="90" height="22" forecolor="#082A52" mode="Opaque" backcolor="#E3EFFB"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Código]]></text></staticText>
<staticText><reportElement x="90" y="26" width="365" height="22" forecolor="#082A52" mode="Opaque" backcolor="#E3EFFB"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Cargo]]></text></staticText>
<staticText><reportElement x="455" y="26" width="100" height="22" forecolor="#082A52" mode="Opaque" backcolor="#E3EFFB"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[Empleados activos]]></text></staticText>
</band></groupHeader>
<groupFooter><band height="24"><printWhenExpression><![CDATA[$F{PEDEP_CODIGO} != null]]></printWhenExpression>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="2" width="555" height="18" forecolor="#0B5CAD"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA["Cargos en " + $F{PEDEP_DESCRI} + ": " + $V{CARGOS_DEP}]]></textFieldExpression></textField>
</band></groupFooter>
</group>
<title><band height="70">
<rectangle><reportElement x="0" y="0" width="555" height="62" forecolor="#082A52" backcolor="#082A52"/><graphicElement><pen lineWidth="0.0"/></graphicElement></rectangle>
<staticText><reportElement x="8" y="4" width="330" height="16" forecolor="#9CC3EE"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><text><![CDATA[HOSPITAL GENERAL MONSTER SALUD]]></text></staticText>
<staticText><reportElement x="8" y="18" width="330" height="26" forecolor="#FFFFFF"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="17" isBold="true"/></textElement><text><![CDATA[Reporte de cargos]]></text></staticText>
<staticText><reportElement x="8" y="42" width="330" height="16" forecolor="#C7DBF2"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><text><![CDATA[SIGH · Subsistema de Personal · GR07]]></text></staticText>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="287" y="6" width="260" height="16" forecolor="#FFFFFF"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Fecha: " + new java.text.SimpleDateFormat("dd/MM/yyyy HH:mm").format(new java.util.Date())]]></textFieldExpression></textField>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="287" y="22" width="260" height="16" forecolor="#FFFFFF"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Generado por: " + $P{USUARIO}]]></textFieldExpression></textField>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="340" y="38" width="207" height="16" forecolor="#FFFFFF"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$P{FILTROS}.isEmpty() ? "Todos los departamentos" : "Filtros: " + $P{FILTROS}]]></textFieldExpression></textField>
</band></title>
<detail><band height="20"><textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="0" width="90" height="20" forecolor="#1F2937"></reportElement><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#D5E1EE"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="true"/></textElement><textFieldExpression><![CDATA[$F{PEDEP_CODIGO} + "-" + $F{PECAR_CODIGO}]]></textFieldExpression></textField>
<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="90" y="0" width="365" height="20" forecolor="#1F2937"></reportElement><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#D5E1EE"/></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{PECAR_DESCRI}]]></textFieldExpression></textField>
<textField isStretchWithOverflow="true" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="455" y="0" width="100" height="20" forecolor="#1F2937"></reportElement><box leftPadding="4" rightPadding="4"><bottomPen lineWidth="0.5" lineColor="#D5E1EE"/></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA[$F{EMPLEADOS}]]></textFieldExpression></textField></band></detail>
<pageFooter><band height="22">
<line><reportElement x="0" y="2" width="555" height="1" forecolor="#D5E1EE"/></line>
<staticText><reportElement x="0" y="4" width="300" height="16" forecolor="#4B5563"/><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><text><![CDATA[Hospital General Monster Salud · SIGH]]></text></staticText>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="395" y="4" width="120" height="16" forecolor="#4B5563"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER} + " de"]]></textFieldExpression></textField>
<textField evaluationTime="Report" isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="515" y="4" width="40" height="16" forecolor="#4B5563"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Left" verticalAlignment="Middle"><font size="8" isBold="false"/></textElement><textFieldExpression><![CDATA[$V{PAGE_NUMBER}]]></textFieldExpression></textField>
</band></pageFooter>
<summary><band height="56">
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="4" width="555" height="22" forecolor="#4B5563"><printWhenExpression><![CDATA[$V{REPORT_COUNT} == 0]]></printWhenExpression></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Center" verticalAlignment="Middle"><font size="10" isBold="true"/></textElement><textFieldExpression><![CDATA["No hay cargos para el filtro seleccionado."]]></textFieldExpression></textField>
<textField isBlankWhenNull="true"><reportElement stretchType="RelativeToTallestObject" x="0" y="32" width="555" height="18" forecolor="#082A52"></reportElement><box leftPadding="4" rightPadding="4"></box><textElement textAlignment="Right" verticalAlignment="Middle"><font size="9" isBold="true"/></textElement><textFieldExpression><![CDATA["Total de cargos: " + $V{REPORT_COUNT}]]></textFieldExpression></textField>
</band></summary>

</jasperReport>
